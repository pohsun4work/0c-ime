#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export GO111MODULE = on
export GOTOOLCHAIN = local
export GOPROXY = off
export GOCACHE = $(CURDIR)/debian/gocache

UPSTREAM_VERSION := $(shell dpkg-parsechangelog -SVersion | sed 's/-[^-]*$$//')

%:
	dh $@ --buildsystem=makefile

override_dh_auto_build:
	$(MAKE) build PREFIX=/usr VERSION=$(UPSTREAM_VERSION) FCITX5=1 IBUS=1 SETTINGS=0

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr VERSION=$(UPSTREAM_VERSION) \
		FCITX5=1 IBUS=1 SETTINGS=0 MODEL_DOWNLOAD=1

override_dh_auto_clean:
	rm -rf build debian/gocache

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	@echo "Skipping upstream tests until the Debian Go module dependencies are pinned; see debian/README.source."
endif

override_dh_missing:
	dh_missing --fail-missing
